# Copy to .env and adjust. Every variable is optional; these are the defaults.
# Settings are read from GLIMPSE_* environment variables (or this file).

GLIMPSE_RUNNER=docker              # docker | lambda | unsafe-local (no isolation!)
GLIMPSE_HOST=127.0.0.1
GLIMPSE_PORT=8000
GLIMPSE_LOG_LEVEL=info
GLIMPSE_RATE_LIMIT=30/minute       # per client IP on POST /v1/execute; "off" disables
# GLIMPSE_GLOBAL_RATE_LIMIT=600/minute  # across all clients; protects a public instance
# GLIMPSE_API_KEYS=key1,key2       # require `Authorization: Bearer <key>` on /v1/execute
# GLIMPSE_CORS_ORIGINS=https://glimpse.daviskeene.com
# GLIMPSE_TRUST_PROXY=true         # behind a proxy: rate-limit on the forwarded client IP
# GLIMPSE_CLIENT_IP_HEADER=CF-Connecting-IP  # header with the real client IP (with TRUST_PROXY)

# Public instance (deploy/docker-compose.prod.yml)
# GLIMPSE_DOMAIN=api.glimpse.example.com

# Request limits
GLIMPSE_MAX_CODE_BYTES=65536
GLIMPSE_MAX_STDIN_BYTES=65536
GLIMPSE_MAX_OUTPUT_BYTES=65536
GLIMPSE_DEFAULT_TIMEOUT_S=10
GLIMPSE_MAX_TIMEOUT_S=30

# Docker runner
GLIMPSE_SANDBOX_IMAGE=glimpse-sandbox
GLIMPSE_SANDBOX_POOL_SIZE=2        # warm containers kept ready
GLIMPSE_SANDBOX_MAX_CONCURRENCY=4  # executions in flight before 503s
GLIMPSE_SANDBOX_MEMORY_MB=512
GLIMPSE_SANDBOX_CPUS=1.0
GLIMPSE_SANDBOX_PIDS_LIMIT=128
GLIMPSE_SANDBOX_TMPFS_MB=64

# Lambda runner
# GLIMPSE_LAMBDA_FUNCTION_NAME=glimpse
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
