# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration (never commit credentials)
.env
.env.*
!.env.example
# .env.production carries only the public build-time API URL (Vite convention: commit it;
# only .env*.local are secret) — the demo build needs it, so keep it tracked.
!.env.production
!.env.*.example

